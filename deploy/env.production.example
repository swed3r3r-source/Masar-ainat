# ============================================================================
# مسار عينات — قالب إعداد الإنتاج
#
# انسخه إلى /etc/masar/masar.env واملأ القيم، ثم:
#     chown root:masar /etc/masar/masar.env && chmod 640 /etc/masar/masar.env
#
# لا يُرفع هذا الملف بعد ملئه إلى أي مستودع. القيم المُعلَّمة «ولّد» يجب أن
# تُولَّد عشوائيًا لكل بيئة — إعادة استخدام قيمة تطوير في الإنتاج يمنعها فحص
# الإقلاع (scripts/preflight.py) ولا يمر بها الخادم.
# ============================================================================

MASAR_ENV=production

# ------------------------------------------------------------ قاعدة البيانات
MASAR_DB_HOST=db.internal
MASAR_DB_PORT=5432
MASAR_DB_NAME=masar
MASAR_DB_USER=masar_app
MASAR_DB_PASSWORD=CHANGE_ME   # ولّد: openssl rand -base64 24
MASAR_DB_MIGRATE_USER=masar_migrate
MASAR_DB_MIGRATE_PASSWORD=CHANGE_ME   # ولّد: openssl rand -base64 24
# require كحد أدنى؛ verify-full أفضل ويتطلب شهادة الخادم لدى العميل
MASAR_DB_SSLMODE=verify-full
MASAR_DB_POOL_MIN=2
MASAR_DB_POOL_MAX=20

# ------------------------------------------------------------------- الأمان
MASAR_JWT_SECRET=GENERATE_AT_DEPLOYMENT   # ولّد: openssl rand -base64 48  (٣٢ حرفًا فأكثر)
MASAR_ACCESS_TOKEN_MINUTES=30
MASAR_REFRESH_TOKEN_DAYS=14
MASAR_IDLE_TIMEOUT_MINUTES=120
MASAR_MAX_LOGIN_ATTEMPTS=5
MASAR_LOCKOUT_MINUTES=15
MASAR_RATE_LIMIT_PER_MINUTE=240
MASAR_LOGIN_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------- التشفير عند التخزين (بيانات صحية)
# حلقة مفاتيح تدعم التدوير: "معرّف:مفتاح_base64" مفصولة بفواصل.
# ولّد مفتاحًا: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# عند التدوير: أضف k2 وغيّر ACTIVE_KEY إلى k2 — ولا تحذف k1 قبل إعادة تشفير ما شُفّر به.
MASAR_ENCRYPTION_KEYS=dev1:GENERATE_AT_DEPLOYMENT
MASAR_ENCRYPTION_ACTIVE_KEY=

# ------------------------------------------------------------------ التخزين
MASAR_STORAGE_BACKEND=s3
MASAR_S3_ENDPOINT=
MASAR_S3_BUCKET=masar-documents
MASAR_S3_ACCESS_KEY=
MASAR_S3_SECRET_KEY=
MASAR_S3_REGION=me-central-1

# ------------------------------------------------------------- مزوّد الطرق
# haversine تقديري ويرفضه فحص الإقلاع في الإنتاج: الخطة المبنية على تقدير
# لا تصلح لالتزام SLA حقيقي.
MASAR_ROUTING_PROVIDER=osrm
MASAR_OSRM_URL=http://osrm.internal:5000
MASAR_ROUTING_TIMEOUT=20
MASAR_TILE_URL=
MASAR_TILE_ATTRIBUTION=

# ------------------------------------------------------------ محرك التحسين
MASAR_OPTIMIZER_BACKEND=native_alns
MASAR_SOLVE_TIME_LIMIT=25
# عدد عمليات التخطيط المتوازية — ابدأ بعدد الأنوية ناقص واحد
MASAR_SOLVE_WORKERS=4
MASAR_SOLVE_SEED=20260826

# ------------------------------------------------------------------ الحرارة
MASAR_TEMPERATURE_PROVIDER=none
MASAR_TEMPERATURE_URL=
MASAR_TEMPERATURE_API_KEY=
# يجب أن تبقى false في الإنتاج — المحاكاة لا تُعرض كتكامل حقيقي
MASAR_TEMPERATURE_SIMULATION=false

# ---------------------------------------------------------------- الإشعارات
MASAR_NOTIFY_PROVIDER=none
MASAR_SMTP_HOST=
MASAR_SMTP_PORT=587
MASAR_SMTP_USERNAME=
MASAR_SMTP_PASSWORD=
MASAR_NOTIFY_SENDER_EMAIL=no-reply@masar.example
MASAR_SMS_URL=
MASAR_SMS_API_KEY=

# --------------------------------------------------------------------- عام
MASAR_TZ=Asia/Riyadh
# يجب أن تبقى false في الإنتاج — محفّز قاعدة البيانات يرفض بيانات الاختبار
MASAR_ALLOW_TEST_DATA=false
MASAR_PORT=8080
