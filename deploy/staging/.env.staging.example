# قالب إعداد البيئة التجريبية — **بلا أي سر**.
#
# لا تنسخه يدويًا: `scripts/staging-up.sh` يولّد `.env.staging` منه ويملأ كل
# قيمة معلَّمة CHANGE_ME أو GENERATE_AT_DEPLOYMENT بقيمة عشوائية قوية.
# الملف الناتج مستبعَد من المستودع (راجع .gitignore) — أبقِه كذلك.
#
# فحص أسرار التصدير يرفض أي قيمة هنا ليست نائبًا معلنًا، فلا يمكن أن ينتهي
# سر في هذا الملف سهوًا: البناء يتوقف.

# ── الهوية ────────────────────────────────────────────────────────────────
# staging وليس production: بيئة تجريبية تقبل بيانات موسومة is_test_data،
# ويرفضها الإنتاج بمحفّز في قاعدة البيانات.
APP_ENV=staging
MASAR_ENV=staging

# ── قاعدة البيانات (غير مكشوفة للمضيف ولا للإنترنت) ───────────────────────
MASAR_DB_NAME=masar_staging
MASAR_DB_USER=masar_app
MASAR_DB_PASSWORD=CHANGE_ME
MASAR_DB_MIGRATE_USER=masar_migrate
MASAR_DB_MIGRATE_PASSWORD=CHANGE_ME

# ── المصادقة ──────────────────────────────────────────────────────────────
MASAR_JWT_SECRET=GENERATE_AT_DEPLOYMENT

# ── التشفير عند التخزين ───────────────────────────────────────────────────
# في staging **يُشترط** AES-256-GCM عبر مكتبة cryptography. التنفيذ
# الاحتياطي مسموح في development و test فقط، ويرفض preflight الإقلاع دونه.
MASAR_ENCRYPTION_KEYS=stg1:GENERATE_AT_DEPLOYMENT
MASAR_ENCRYPTION_ACTIVE_KEY=stg1

# ── مزوّد الطرق ───────────────────────────────────────────────────────────
# ثابت على osrm ولا يُغيَّر هنا: haversine تقديري وينحرف عن الطرق الحقيقية
# +28٪ مسافةً و+64٪ زمنًا في اتجاهين متعاكسين، ولا يصلح لتجربة واقعية.
MASAR_OSRM_BLOCK_SIZE=100
MASAR_OSRM_MAX_TABLE=2000

# ── المنافذ المكشوفة (nginx وحده) ─────────────────────────────────────────
# المنفذ 8080 غير مكشوف إطلاقًا. غيّر هذين فقط عند تعارض على المضيف.
MASAR_HTTP_PORT=80
MASAR_HTTPS_PORT=443

# ── التشغيل ───────────────────────────────────────────────────────────────
MASAR_SOLVE_WORKERS=2

# ── ما لا يوضع هنا أبدًا ──────────────────────────────────────────────────
# كلمات مرور الحسابات التجريبية: يولّدها `staging-up.sh` عند التشغيل ويطبعها
# على الشاشة مرة واحدة. لا تُكتب في ملف ولا تدخل المستودع.
