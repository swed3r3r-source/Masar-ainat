# قالب إعداد بيئة التطوير — انسخه إلى .env.dev واملأ القيم.
#
#     cp .env.example .env.dev
#
# **لا يحتوي هذا الملف على أي سر حقيقي، ولا يجوز أن يحتوي.** كل قيمة معلَّمة
# «ولّد» تُنتَج بالأمر المذكور بجوارها. الملف .env.dev مستبعَد من المستودع
# (راجع .gitignore) — أبقِه كذلك.
#
# لبيئة الإنتاج استخدم deploy/env.production.example بدل هذا الملف؛ فيه
# قيود أشد يفرضها scripts/preflight.py عند الإقلاع.

MASAR_ENV=development

# ── قاعدة البيانات ────────────────────────────────────────────────────────
MASAR_DB_HOST=127.0.0.1
MASAR_DB_PORT=55432
MASAR_DB_NAME=masar_dev
MASAR_DB_SSLMODE=disable

# دوران منفصلان عمدًا: التطبيق لا يملك صلاحية تعديل المخطط، والترحيل لا
# يُستخدم في التشغيل اليومي.
MASAR_DB_USER=masar_app
MASAR_DB_PASSWORD=CHANGE_ME   # ولّد: openssl rand -base64 24
MASAR_DB_MIGRATE_USER=masar_migrate
MASAR_DB_MIGRATE_PASSWORD=CHANGE_ME   # ولّد: openssl rand -base64 24

# ── المصادقة ──────────────────────────────────────────────────────────────
# ولّد: openssl rand -base64 48
# preflight يرفض الإقلاع في الإنتاج بسر قصير أو يحمل علامات القيم التجريبية.
MASAR_JWT_SECRET=GENERATE_AT_DEPLOYMENT

# ── التشفير عند التخزين (§20) ─────────────────────────────────────────────
# صيغة الحلقة: "معرّف:مفتاح-base64,معرّف2:مفتاح2" — تسمح بالتدوير بلا توقف.
# ولّد مفتاحًا: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#
# ⚠ فقدان مفتاح = فقدان كل ما شُفّر به **نهائيًا**. احفظ الحلقة في خزنة أسرار
#   بنسخة احتياطية مستقلة عن نسخة قاعدة البيانات.
MASAR_ENCRYPTION_KEYS=dev1:GENERATE_AT_DEPLOYMENT   # مثال الشكل: dev1:<32-bytes-base64>
MASAR_ENCRYPTION_ACTIVE_KEY=dev1

# ── مزوّد الطرق ───────────────────────────────────────────────────────────
# haversine = تقديري معلن (خط مستقيم × معامل التفافية). الانحراف المقيس عن
# شبكة الطرق الحقيقية: +28٪ مسافةً و+64٪ زمنًا، في اتجاهين متعاكسين.
# اعتماد الخطط المبنية عليه **مرفوض في بيئة الإنتاج**.
#
# للتفعيل الحقيقي: ./deploy/osrm/activate.sh ثم:
#   MASAR_ROUTING_PROVIDER=osrm
#   MASAR_OSRM_URL=http://127.0.0.1:5000
MASAR_ROUTING_PROVIDER=haversine
# MASAR_OSRM_URL=
# MASAR_OSRM_BLOCK_SIZE=100   # اخفضه إلى ٥٠ إن ظهر 414 أو TooBig

# ── التشغيل ───────────────────────────────────────────────────────────────
MASAR_SOLVE_WORKERS=2         # قاربه بعدد أنوية المعالج
MASAR_ALLOW_TEST_DATA=true    # للتطوير فقط — الإنتاج يرفض الصفوف الموسومة

# ── كلمات مرور بيانات الاختبار ────────────────────────────────────────────
# اتركها فارغة: scripts/seed.py يولّد كلمة مرور عشوائية ويطبعها مرة واحدة،
# و./scripts/run_tests.sh يولّد واحدة لكل تشغيل ويمررها للاختبارات.
# لا توجد كلمة مرور افتراضية في الكود — وهذا مقصود.
# MASAR_SEED_PASSWORD=
